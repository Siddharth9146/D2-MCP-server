# From https://www.bungie.net/en/Application  (create an app, OAuth Client Type: Confidential)
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Must match the "Redirect URL" you set on the Bungie app page exactly.
# Bungie requires https; the login command serves this with a self-signed cert.
BUNGIE_REDIRECT_URL=https://localhost:7778/callback

# Where tokens and the manifest cache are stored (default: ~/.d2-guide)
# D2_GUIDE_HOME=

# Manifest language (en, de, fr, es, it, ja, ko, pl, pt-br, ru, zh-chs, zh-cht, es-mx)
# D2_LANGUAGE=en
